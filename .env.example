# Anthropic API key for Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here

# WebSocket relay (see worker/ for the Cloudflare Worker that backs this)
SUMMER_WEBSOCKET_URL=wss://your-worker.workers.dev/channels/summer
WEBSOCKET_SERVER_URL=wss://your-worker.workers.dev
BROADCAST_API_URL=https://your-worker.workers.dev/broadcast

# File upload service
FILE_UPLOAD_API_URL=https://your-file-upload-api.workers.dev/upload

# TLS verification for outbound HTTPS/WSS. Defaults to enabled.
# Set to 0/false/no/off to disable (e.g. local dev against a self-signed cert).
SUMMER_VERIFY_TLS=1

# iMessage / Apple Shortcuts integration (macOS only)
# Path the "sendmessage" Shortcut reads from. Defaults to <repo>/shortcuts-ipc/in.txt.
SUMMER_IPC_FILE=

# Directory containing your shortcut-tools scripts (calendar, email, etc.)
# Defaults to <repo>/shortcut-tools if unset.
SUMMER_SHORTCUTS_DIR=

# Proactive scheduler — sqlite file that persists scheduled check-ins.
# Defaults to <repo>/proactive.db.
SUMMER_SCHEDULER_DB=

# How often the scheduler polls for due check-ins. 30s is plenty in prod;
# drop to 1–2s when smoke-testing.
SUMMER_SCHEDULER_POLL_SECONDS=30

# Context engine — semantic fact store + ingestion
# sqlite DB that holds extracted facts + embeddings. Default: <repo>/context_facts.db
SUMMER_FACT_DB=

# Embedder backend. "sentence-transformers" (local, default) or "openai"
# (requires OPENAI_API_KEY).
SUMMER_EMBEDDER=sentence-transformers

# Optional: file-backed email source for demos (JSONL).
SUMMER_EMAIL_FIXTURE=

# Event-driven calendar wake-ups via EventKit (macOS only).
# Set to 0 to disable. Requires pyobjc-framework-EventKit and Calendar access.
# (Kept for backwards compatibility; equivalent to SUMMER_TRIGGER_CALENDAR.)
SUMMER_CALENDAR_MONITOR=1

# ----- External event triggers -----
# Each trigger is on by default if its dependencies are present. Set any of
# these to 0 to disable that source.
SUMMER_TRIGGER_CALENDAR=1
SUMMER_TRIGGER_EMAIL=1
SUMMER_TRIGGER_WEBHOOK=1
SUMMER_TRIGGER_FILE_WATCHER=1

# Email trigger. If SUMMER_IMAP_HOST is unset, the trigger falls back to
# tailing the JSONL file at SUMMER_EMAIL_FIXTURE (great for demos).
SUMMER_IMAP_HOST=
SUMMER_IMAP_USER=
SUMMER_IMAP_PASSWORD=
SUMMER_IMAP_FOLDER=INBOX
SUMMER_IMAP_POLL_SECONDS=60

# Webhook trigger. POST JSON to http://<bind>:<port>/trigger.
# Set SUMMER_WEBHOOK_TOKEN to require an X-Summer-Token header.
SUMMER_WEBHOOK_PORT=8848
SUMMER_WEBHOOK_BIND=127.0.0.1
SUMMER_WEBHOOK_TOKEN=

# File watcher trigger. Comma-separated list of directories to watch.
# Example: SUMMER_FILE_WATCH_PATHS=~/Downloads,~/Desktop/inbox
SUMMER_FILE_WATCH_PATHS=
